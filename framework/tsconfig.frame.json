{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@acryldev/app-shell": ["../plugins/app-shell/src/index.ts"],
      "@acryldev/app-shell/client": ["../plugins/app-shell/src/client/index.ts"],
      "@acryldev/control": ["../runtime/control/src/index.ts"],
      "@acryldev/diagnostics": ["../runtime/diagnostics/src/index.ts"],
      "@acryldev/loopback-http": ["../runtime/loopback-http/src/index.ts"],
      "@acryldev/loopback-http/router": ["../runtime/loopback-http/src/router.ts"],
      "@acryldev/settings": ["../plugins/settings/src/index.ts"],
      "@acryldev/versions": ["./acryl-versions/src/index.ts"],
      "@acryldev/versions/client": ["./acryl-versions/src/client/index.ts"],
      "@acryldev/workspace": ["../plugins/workspace/src/index.ts"],
      "@acryldev/workspace/client": ["../plugins/workspace/src/client/index.ts"],
      "@acryldev/workspace/ui": ["../plugins/workspace/src/client/ui.ts"]
    }
  },
  "include": [
    "../plugins/app-context/src/**/*.ts",
    "../plugins/app-context/src/**/*.tsx",
    "../plugins/app-context/tests/**/*.ts",
    "../plugins/blends-frame/src/**/*.ts",
    "../plugins/blends-frame/src/**/*.tsx",
    "../plugins/blends-frame/tests/**/*.ts",
    "../plugins/versions/src/**/*.ts",
    "../plugins/versions/src/**/*.tsx",
    "../plugins/versions/tests/**/*.ts",
    // @acryldev/workspace/ui (reached by path above) imports its terminal CSS through this declaration.
    "../plugins/workspace/src/client/terminal/xterm-css.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/lib/**",
    "**/tests/fixtures/**",
    // Workaround, to be fixed with a types-only import path: dsh-tools' Context augmentation (server-side `sessions`) leaks into the client packages.
    "../plugins/app-context/**"
  ]
}
