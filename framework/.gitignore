# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores Visual Studio Code versions used for testing Visual Studio Code extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro generated types
.astro/

# Turbo Repo
.turbo

# macOS
.DS_Store

# build
dist/
*.tsbuildinfo

# generated by docs/test (snippets extracted from the markdown)
docs/.generated/

# Demo apps and the showcase run (local only, see demos/README.md)
demos/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Build output of the framework packages (rebuilt by pnpm run build)
plugins/acryl-*/lib/
packages/framework/lib/
plugins/acryl-*/src/**/*.d.ts

# The upgrade tests unpack apps made by published versions (scripts/make-upgrade-fixtures.mjs).
!packages/cli/test/fixtures/upgrade/*.tgz

# Slice 0 spike build output (rebuilt by spikes/ide-slice0/run.sh)
spikes/ide-slice0/dsh-client-ui-brand-acryl/lib/

# The IDE port's packages build lib/ like the framework's; only source is committed.
ide/*/lib/
# acryl-brand ships lib/identity.js as source, not build output
!ide/acryl-brand/lib/
ide/acryl-ui/registry-seed/

# The materialized frame fixture (scripts/frame-fixtures/review-fixture/setup.mjs recreates it byte-identically)
.frame-fixture/

# The app-context examples gate mounts each example in a throwaway app here.
ide/acryl-app-context/tests/.apps/
ide/acryl-app-context/tests/.apps-*/
