{
  "name": "acrylblends-monorepo",
  "private": true,
  "type": "module",
  "description": "ACRYLBLENDS - scaffold apps built on Cordis. Cordis is the framework.",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./plugins/acryl-*' run build && node scripts/stage-framework.mjs && pnpm -r --filter='{./ide/*}...' run build",
    "test:driver-pty": "node --import ./scripts/workspace-source.mjs --test --test-timeout=60000 \"plugins/driver-pty/test/*.test.ts\"",
    "test:packages": "pnpm -r --filter=./plugins/acryl-* --filter=acrylblends-framework --filter=./ide/* run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p plugins/tsconfig.json && tsc -p ide/tsconfig.json",
    "test": "vitest run && pnpm run test:packages && node --import ./scripts/workspace-source.mjs --test \"plugins/*/test/*.test.ts\" && node --test scripts/lib/*.test.mjs workshop-registry/test/*.test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:scaffolder": "node scripts/verify-scaffolder.mjs",
    "verify:core-boundary": "node scripts/verify-core-boundary.mjs",
    "try": "node scripts/try-from-checkout.mjs",
    "verify:ide-host": "node --import ./scripts/workspace-source.mjs scripts/verify-ide-host.mjs",
    "verify:frame-publish": "node --import ./scripts/workspace-source.mjs scripts/verify-frame-publish.mjs",
    "verify:ide-template": "node --import ./scripts/workspace-source.mjs scripts/verify-ide-template.mjs blank",
    "check": "pnpm run lint && pnpm run verify:workflows && pnpm run build && pnpm run verify:framework && pnpm run verify:secrets && pnpm run typecheck && pnpm run typecheck:packages && pnpm run test && pnpm run verify:scaffolder && pnpm run verify:core-boundary && pnpm run verify:ide-host && pnpm run verify:ide-template && pnpm run verify:legacy-layouts && pnpm run verify:upgrade-frame && pnpm run verify:byo && pnpm run verify:panel && pnpm run verify:door && pnpm run verify:dev-install && pnpm run verify:production && pnpm run verify:driver-pty && pnpm run verify:packed && pnpm run verify:tarball && pnpm run verify:vitest-peer",
    "verify:model": "node scripts/verify-real-model.mjs",
    "verify:framework": "node scripts/stage-framework.mjs --check",
    "verify:secrets": "node scripts/verify-docs-secrets.mjs",
    "verify:driver-pty": "node scripts/verify-driver-pty.mjs",
    "verify:byo": "node scripts/verify-byo-tool.mjs",
    "verify:panel": "node scripts/verify-agent-panel.mjs",
    "verify:assistant": "node scripts/verify-assistant.mjs",
    "verify:door": "node scripts/verify-door-reload.mjs",
    "verify:dev-install": "node scripts/verify-dev-install.mjs",
    "verify:desktop": "node --import ./scripts/workspace-source.mjs scripts/verify-desktop-door.mjs",
    "verify:production": "node scripts/verify-production-extension.mjs",
    "verify:vitest-peer": "node scripts/verify-vitest-peer.mjs",
    "verify:create": "node scripts/verify-create-npm.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "verify:legacy-layouts": "node scripts/build-legacy-layouts.mjs --check",
    "verify:upgrade-frame": "node --import ./scripts/workspace-source.mjs scripts/verify-upgrade-frame.mjs",
    "typecheck:packages": "pnpm -r --if-present --filter='./packages/*' --filter='./plugins/acryl-*' --filter='./ide/*' run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "jsdom": "29.1.1",
    "@types/jsdom": "30.0.0",
    "actionlint": "2.0.6",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "@webboxes/app-persistence": "0.1.2",
    "@webboxes/blends-core": "0.5.0",
    "@webboxes/plugin-hub": "0.2.2",
    "@whatwg-node/fetch": "0.9.23",
    "ajv": "^8.20.0",
    "msw": "2.15.0",
    "node-pty": "1.2.0-beta.15",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  }
}
