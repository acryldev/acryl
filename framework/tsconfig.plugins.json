{
  "//": "The framework app plugins that live in the root plugins/ folder (spec 051 T017): one project for their sources and tests, with the library packages mapped to source.",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "acryl-db": ["../plugins/acryl-db/src/index.ts"],
      "acryl-db/cordis": ["../plugins/acryl-db/src/cordis.ts"],
      "acryl-db/conformance": ["../plugins/acryl-db/src/conformance.ts"],
      "acryl-db-sqlite": ["../plugins/acryl-db-sqlite/src/index.ts"],
      "acryl-db-sqlite/open": ["../plugins/acryl-db-sqlite/src/open.ts"],
      "acryl-door": ["../plugins/acryl-door/src/index.ts"],
      "acryl-inspect": ["../plugins/acryl-inspect/src/index.ts"],
      "acryl-kv": ["../plugins/acryl-kv/src/index.ts"],
      "acryl-kv/cordis": ["../plugins/acryl-kv/src/cordis.ts"],
      "acryl-kv/conformance": ["../plugins/acryl-kv/src/conformance.ts"],
      "acryl-kv-db": ["../plugins/acryl-kv-db/src/index.ts"],
      "acryl-kv-db/open": ["../plugins/acryl-kv-db/src/open.ts"],
      "acryl-kv-json": ["../plugins/acryl-kv-json/src/index.ts"],
      "acryl-kv-json/open": ["../plugins/acryl-kv-json/src/open.ts"],
      "acryl-node-server": ["../plugins/acryl-node-server/src/index.ts"],
      "acryl-node-server/client-modules": ["../plugins/acryl-node-server/src/client-modules.ts"],
      "acryl-router": ["../plugins/acryl-router/src/index.ts"],
      "acryl-router/middleware": ["../plugins/acryl-router/src/middleware/index.ts"],
      "acryl-router/helpers": ["../plugins/acryl-router/src/helpers/index.ts"],
      "acryl-router/client": ["../plugins/acryl-router/src/client.ts"],
      "acryl-router/jsx": ["../plugins/acryl-router/src/core/jsx/index.ts"],
      "acryl-router/jsx/jsx-runtime": ["../plugins/acryl-router/src/core/jsx/jsx-runtime.ts"],
      "acryl-router/jsx/jsx-dev-runtime": [
        "../plugins/acryl-router/src/core/jsx/jsx-dev-runtime.ts"
      ],
      "acryl-router/jsx/streaming": ["../plugins/acryl-router/src/core/jsx/streaming.ts"],
      "acryl-router-http": ["../plugins/acryl-router-http/src/index.ts"],
      "acryl-state": ["../plugins/acryl-state/src/index.ts"],
      "acryl-state/react": ["../plugins/acryl-state/src/react.ts"],
      "acryl-agent": ["../plugins/agent/index.ts"],
      "acryl-instance": ["../plugins/instance/index.ts"],
      "acryl-instance/storage": ["../plugins/instance/storage.ts"],
      "acryl-instance/bundle": ["../plugins/instance/bundle.ts"],
      "acryl-instance/home": ["../plugins/instance/home.ts"],
      "acryl-desktop-shell": ["../plugins/desktop/launch.ts"],
      "acryl-desktop-shell/main": ["../plugins/desktop/main.ts"],
      "acryl-desktop-web": ["../plugins/desktop-web/launch.ts"],
      "acryl-desktop-web/main": ["../plugins/desktop-web/main.ts"],
      "acryl-sandbox": ["../plugins/sandbox/index.ts"],
      "acryl-home": ["../plugins/home/index.ts"],
      "acryl-tasks": ["../plugins/tasks/index.ts"],
      "acryl-extensions": ["../plugins/extensions/index.ts"],
      "acryl-manifest": ["../plugins/manifest/index.ts"],
      "acryl-manifest/lock": ["../plugins/manifest/lock.ts"],
      "acryl-manifest/snapshot": ["../plugins/manifest/snapshot.ts"],
      "acryl-manifest/app-plugins": ["../plugins/manifest/app-plugins.ts"],
      "acryl-save": ["../plugins/save/index.ts"],
      "acryl-app-settings": ["../plugins/settings/index.ts"],
      "acryl-feedback": ["../plugins/feedback/index.ts"],
      "acryl-openai": ["../plugins/openai/index.ts"],
      "acryl-builder": ["../plugins/builder/index.ts"],
      "acryl-builder/script": ["../plugins/builder/script.ts"],
      "acryl-showcase": ["../plugins/showcase/index.ts"],
      "acryl-plugin-share": ["../plugins/plugin-share/index.ts"],
      "acryl-plugin-share/package": ["../plugins/plugin-share/package.ts"],
      "acryl-agent-panel": ["../plugins/agent-panel/index.ts"],
      "acryl-agent-panel/drivers": ["../plugins/agent-panel/drivers.ts"],
      "acryl-agent-panel/headless": ["../plugins/agent-panel/headless.ts"],
      "acryl-agent-panel/registry": ["../plugins/agent-panel/registry.ts"],
      "acryl-agent-panel/mount": ["../plugins/agent-panel/mount.ts"],
      "acryl-driver-acp": ["../plugins/driver-acp/index.ts"],
      "acryl-driver-pty": ["../plugins/driver-pty/index.ts"],
      "acryl-router/core": ["../plugins/acryl-router/src/core/index.ts"],
      "acryl-router/conninfo": ["../plugins/acryl-router/src/core/helper/conninfo/index.ts"],
      "acryl-node-server/adapter": ["../plugins/acryl-node-server/src/adapter/index.ts"],
      "acryl-node-server/conninfo": ["../plugins/acryl-node-server/src/adapter/conninfo.ts"],
      "acryl-node-server/upgrade-hub": ["../plugins/acryl-node-server/src/upgrade-hub.ts"],
      "acryl-router/connection": ["../plugins/acryl-router/src/connection.ts"],
      "acryl-node-server/serve-static": [
        "../plugins/acryl-node-server/src/adapter/serve-static.ts"
      ],
      "acryl-node-server/test-websocket": ["../plugins/acryl-node-server/src/test-websocket.ts"]
    }
  },
  "include": [
    "../plugins/agent/**/*.ts",
    "../plugins/agent-panel/**/*.ts",
    "../plugins/builder/**/*.ts",
    "../plugins/desktop/**/*.ts",
    "../plugins/desktop-web/**/*.ts",
    "../plugins/driver-acp/**/*.ts",
    "../plugins/driver-pty/**/*.ts",
    "../plugins/extensions/**/*.ts",
    "../plugins/feedback/**/*.ts",
    "../plugins/home/**/*.ts",
    "../plugins/instance/**/*.ts",
    "../plugins/manifest/**/*.ts",
    "../plugins/openai/**/*.ts",
    "../plugins/plugin-share/**/*.ts",
    "../plugins/sandbox/**/*.ts",
    "../plugins/save/**/*.ts",
    "../plugins/settings/**/*.ts",
    "../plugins/showcase/**/*.ts",
    "../plugins/tasks/**/*.ts"
  ],
  "exclude": [
    "../plugins/desktop/main.ts",
    "../plugins/desktop/update-menu.ts",
    "../plugins/desktop/window.ts",
    "../plugins/desktop-web/main.ts",
    "../plugins/desktop-web/window.ts"
  ]
}
