{
  "//": "The framework app plugins that live in the root plugins/ folder (spec 051 T017): one project for their sources and tests, with the library packages mapped to source.",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@acryldev/drivers": ["../plugins/drivers/index.ts"],
      "@acryldev/db": ["../plugins/db/src/index.ts"],
      "@acryldev/db/cordis": ["../plugins/db/src/cordis.ts"],
      "@acryldev/db/conformance": ["../plugins/db/src/conformance.ts"],
      "@acryldev/db-sqlite": ["../plugins/db-sqlite/src/index.ts"],
      "@acryldev/db-sqlite/open": ["../plugins/db-sqlite/src/open.ts"],
      "@acryldev/door": ["../plugins/door/src/index.ts"],
      "@acryldev/inspect": ["../plugins/inspect/src/index.ts"],
      "@acryldev/kv": ["../plugins/kv/src/index.ts"],
      "@acryldev/kv/cordis": ["../plugins/kv/src/cordis.ts"],
      "@acryldev/kv/conformance": ["../plugins/kv/src/conformance.ts"],
      "@acryldev/kv-db": ["../plugins/kv-db/src/index.ts"],
      "@acryldev/kv-db/open": ["../plugins/kv-db/src/open.ts"],
      "@acryldev/kv-json": ["../plugins/kv-json/src/index.ts"],
      "@acryldev/kv-json/open": ["../plugins/kv-json/src/open.ts"],
      "@acryldev/node-server": ["../plugins/node-server/src/index.ts"],
      "@acryldev/node-server/client-modules": ["../plugins/node-server/src/client-modules.ts"],
      "@acryldev/router": ["../plugins/router/src/index.ts"],
      "@acryldev/router/middleware": ["../plugins/router/src/middleware/index.ts"],
      "@acryldev/router/helpers": ["../plugins/router/src/helpers/index.ts"],
      "@acryldev/router/client": ["../plugins/router/src/client.ts"],
      "@acryldev/router/jsx": ["../plugins/router/src/core/jsx/index.ts"],
      "@acryldev/router/jsx/jsx-runtime": ["../plugins/router/src/core/jsx/jsx-runtime.ts"],
      "@acryldev/router/jsx/jsx-dev-runtime": [
        "../plugins/router/src/core/jsx/jsx-dev-runtime.ts"
      ],
      "@acryldev/router/jsx/streaming": ["../plugins/router/src/core/jsx/streaming.ts"],
      "@acryldev/router-http": ["../plugins/router-http/src/index.ts"],
      "@acryldev/state": ["../plugins/state/src/index.ts"],
      "@acryldev/state/react": ["../plugins/state/src/react.ts"],
      "@acryldev/agent": ["../plugins/agent/index.ts"],
      "@acryldev/instance": ["../plugins/instance/index.ts"],
      "@acryldev/instance/storage": ["../plugins/instance/storage.ts"],
      "@acryldev/instance/bundle": ["../plugins/instance/bundle.ts"],
      "@acryldev/instance/home": ["../plugins/instance/home.ts"],
      "@acryldev/desktop-shell": ["../plugins/desktop-shell/launch.ts"],
      "@acryldev/desktop-shell/main": ["../plugins/desktop-shell/main.ts"],
      "@acryldev/desktop-web": ["../plugins/desktop-web/launch.ts"],
      "@acryldev/desktop-web/main": ["../plugins/desktop-web/main.ts"],
      "@acryldev/sandbox": ["../plugins/sandbox/index.ts"],
      "@acryldev/home": ["../plugins/home/index.ts"],
      "@acryldev/tasks": ["../plugins/tasks/index.ts"],
      "@acryldev/extensions": ["../plugins/extensions/index.ts"],
      "@acryldev/manifest": ["../plugins/manifest/index.ts"],
      "@acryldev/manifest/lock": ["../plugins/manifest/lock.ts"],
      "@acryldev/manifest/snapshot": ["../plugins/manifest/snapshot.ts"],
      "@acryldev/manifest/app-plugins": ["../plugins/manifest/app-plugins.ts"],
      "@acryldev/save": ["../plugins/save/index.ts"],
      "@acryldev/app-settings": ["../plugins/app-settings/index.ts"],
      "@acryldev/feedback": ["../plugins/feedback/index.ts"],
      "@acryldev/openai": ["../plugins/openai/index.ts"],
      "@acryldev/builder": ["../plugins/builder/index.ts"],
      "@acryldev/builder/script": ["../plugins/builder/script.ts"],
      "@acryldev/showcase": ["../plugins/showcase/index.ts"],
      "@acryldev/plugin-share": ["../plugins/plugin-share/index.ts"],
      "@acryldev/plugin-share/package": ["../plugins/plugin-share/package.ts"],
      "@acryldev/agent-panel": ["../plugins/agent-panel/index.ts"],
      "@acryldev/agent-panel/drivers": ["../plugins/agent-panel/drivers.ts"],
      "@acryldev/agent-panel/headless": ["../plugins/agent-panel/headless.ts"],
      "@acryldev/agent-panel/registry": ["../plugins/agent-panel/registry.ts"],
      "@acryldev/agent-panel/mount": ["../plugins/agent-panel/mount.ts"],
      "@acryldev/driver-acp": ["../plugins/driver-acp/index.ts"],
      "@acryldev/driver-pty": ["../plugins/driver-pty/index.ts"],
      "@acryldev/router/core": ["../plugins/router/src/core/index.ts"],
      "@acryldev/router/conninfo": ["../plugins/router/src/core/helper/conninfo/index.ts"],
      "@acryldev/node-server/adapter": ["../plugins/node-server/src/adapter/index.ts"],
      "@acryldev/node-server/conninfo": ["../plugins/node-server/src/adapter/conninfo.ts"],
      "@acryldev/node-server/upgrade-hub": ["../plugins/node-server/src/upgrade-hub.ts"],
      "@acryldev/router/connection": ["../plugins/router/src/connection.ts"],
      "@acryldev/node-server/serve-static": [
        "../plugins/node-server/src/adapter/serve-static.ts"
      ],
      "@acryldev/node-server/test-websocket": ["../plugins/node-server/src/test-websocket.ts"]
    }
  },
  "include": [
    "../plugins/drivers/**/*.ts",
    "../plugins/agent/**/*.ts",
    "../plugins/agent-panel/**/*.ts",
    "../plugins/builder/**/*.ts",
    "../plugins/desktop-shell/**/*.ts",
    "../plugins/desktop-web/**/*.ts",
    "../plugins/driver-acp/**/*.ts",
    "../plugins/driver-pty/**/*.ts",
    "../plugins/extensions/**/*.ts",
    "../plugins/feedback/**/*.ts",
    "../plugins/home/**/*.ts",
    "../plugins/instance/**/*.ts",
    "../plugins/manifest/**/*.ts",
    "../plugins/openai/**/*.ts",
    "../plugins/plugin-share/**/*.ts",
    "../plugins/sandbox/**/*.ts",
    "../plugins/save/**/*.ts",
    "../plugins/app-settings/**/*.ts",
    "../plugins/showcase/**/*.ts",
    "../plugins/tasks/**/*.ts"
  ],
  "exclude": [
    "../plugins/desktop-shell/main.ts",
    "../plugins/desktop-shell/update-menu.ts",
    "../plugins/desktop-shell/window.ts",
    "../plugins/desktop-web/main.ts",
    "../plugins/desktop-web/window.ts"
  ]
}
