{
  "name": "acryl",
  "version": "0.3.0",
  "description": "ACRYL: everything is a plugin. Build agentic apps. One command for the whole platform: ACRYL Control Center in the terminal, a window or the browser (npx acryl)",
  "acrylRuntime": "0.2.7",
  "type": "module",
  "bin": {
    "acryl": "./bin.js"
  },
  "files": [
    "bin.js",
    "cli.js",
    "route.js",
    "help.js",
    "control-center.js",
    "secret-input.js",
    "node-version.js",
    "forward.js",
    "launcher.js",
    "managed.js",
    "runtime.js",
    "release-contract.js",
    "desktop-runtime.js",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "acryl",
    "agentic-apps",
    "ai",
    "agent",
    "plugins",
    "cordis",
    "blends",
    "control-center",
    "cli",
    "tui",
    "developer-tools"
  ],
  "homepage": "https://acryl.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "distribution/acryl-npm-launcher"
  },
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepack": "corepack pnpm --filter @acryldev/app-persistence run build && node tui/bundle.mjs launcher.js"
  },
  "devDependencies": {
    "@acryldev/launcher": "workspace:*",
    "@acryldev/launcher-desktop": "workspace:*",
    "@acryldev/ui-tui": "workspace:*",
    "@earendil-works/pi-tui": "1.1.0",
    "node-pty": "1.2.0-beta.15",
    "rolldown": "1.2.15"
  }
}
