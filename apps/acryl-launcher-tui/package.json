{
  "name": "acryl-launcher-tui",
  "version": "0.1.0",
  "description": "The ACRYL launcher in a terminal (spec 050): every step offered with pi-tui and acryl-ui-tui; bundled into the acryl npm package, opened by a bare `acryl`",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./run.js",
  "exports": {
    ".": "./run.js",
    "./view": "./view.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs",
    "bundle": "node scripts/bundle.mjs dist/launcher.js"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.1.0",
    "acryl-launcher": "workspace:*",
    "acryl-ui-tui": "workspace:*"
  },
  "devDependencies": {
    "rolldown": "1.2.15",
    "node-pty": "1.2.0-beta.15"
  }
}
