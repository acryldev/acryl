{
  "name": "acryl-cli",
  "version": "0.1.44",
  "private": true,
  "description": "Canonical ACRYL pi-tui coding-agent terminal client",
  "license": "MIT",
  "type": "module",
  "bin": {
    "acryl": "./lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "pnpm --filter acryl-control run build && pnpm --filter @webboxes/blends-core run build && pnpm --filter @webboxes/app-persistence run build && pnpm --filter acryl-harness-runtime run build && pnpm --filter cordis-plugin-market... --workspace-concurrency=1 run build && node scripts/generate-build-info.mjs",
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "pretypecheck": "node scripts/generate-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "tui": "node lib/bin.js tui",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check"
  },
