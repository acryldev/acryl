{
  "name": "acryl-ade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#acryl-jsx/jsx-runtime": "./plugins/acryl-router/src/core/jsx/jsx-runtime.ts",
    "#acryl-jsx/jsx-dev-runtime": "./plugins/acryl-router/src/core/jsx/jsx-dev-runtime.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "desktop": "acryl-desktop",
    "acryl": "node plugins/acryl-door/src/cli/acryl.ts",
    "start": "node --import ./plugins/acryl-node-server/src/register.ts src/main.ts",
    "dev": "node --import ./plugins/acryl-node-server/src/register.ts scripts/ide-host.mjs",
    "test": "acrylblends check-deps && node --import ./plugins/acryl-node-server/src/register.ts --test \"test/**/*.test.{ts,tsx}\"",
    "check": "tsc --noEmit && tsc --noEmit -p src/client && acrylblends check-deps",
    "build": "acrylblends build-client",
    "lock": "node plugins/manifest/lock.ts",
    "snapshot": "node plugins/manifest/snapshot.ts",
    "save": "node plugins/save/cli.ts",
    "upgrade": "node plugins/manifest/upgrade-cli.ts",
    "predev": "node scripts/check-node.cjs && node scripts/ade-root.mjs",
    "prestart": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "precheck": "node scripts/check-node.cjs",
    "predesktop": "node scripts/ade-root.mjs"
  },
  "dependencies": {
    "@acryldev/app-context": "^0.2.0",
    "@acryldev/app-persistence": "0.1.5",
    "@acryldev/app-shell": "^0.2.1",
    "@acryldev/blends": "^1.7.2",
    "@acryldev/blends-core": "0.6.0",
    "@acryldev/blends-frame": "^0.2.0",
    "@acryldev/brand-client": "^0.2.1",
    "@acryldev/desktop-shell": "0.1.6",
    "@acryldev/instance": "0.1.2",
    "@acryldev/plugin-admin": "^0.2.1",
    "@acryldev/plugin-hub-core": "0.2.2",
    "@acryldev/settings": "^0.2.1",
    "@acryldev/sign-in": "^0.2.0",
    "@acryldev/support": "^0.2.1",
    "@acryldev/system-prompt": "^0.3.0",
    "@acryldev/versions": "^0.2.0",
    "@acryldev/web": "^0.3.1",
    "@acryldev/workspace": "^0.2.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "js-yaml": "^4.2.0",
    "skill-mcp-manager": "^1.3.1",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.9.3",
    "ws": "8.21.3"
  },
  "overrides": {
    "@deepseek-ai/libreoffice-kit-darwin-arm64": "npm:@acryldev/absent@1.0.1",
    "@deepseek-ai/libreoffice-kit-darwin-x64": "npm:@acryldev/absent@1.0.1",
    "@deepseek-ai/libreoffice-kit-wasm": "npm:@acryldev/absent@1.0.1",
    "@deepseek-ai/libreoffice-kit-win32-arm64": "npm:@acryldev/absent@1.0.1",
    "@deepseek-ai/libreoffice-kit-win32-x64": "npm:@acryldev/absent@1.0.1"
  },
  "acrylblends": {
    "root": "workspace"
  }
}
