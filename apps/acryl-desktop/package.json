{
  "name": "acryl-desktop",
  "version": "0.1.44",
  "description": "ACRYL desktop: a local-first agent workspace composed with Cordis plugins",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "acryl-desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-desktop": "lib/bin.js",
    "acryl-desktop": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./profile": {
      "types": "./lib/types/profile.d.ts",
      "default": "./lib/profile.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./webserver": {
      "types": "./lib/types/runtime/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./windows-pwsh-sandbox": {
      "types": "./lib/types/windows-pwsh-sandbox.d.ts",
      "default": "./lib/windows-pwsh-sandbox.js"
    },
    "./windows-agent-presets": {
      "types": "./lib/types/windows/windows-agent-presets.d.ts",
      "default": "./lib/windows-agent-presets.js"
    },
    "./terminal": {
      "types": "./lib/types/terminal/terminal.d.ts",
      "default": "./lib/terminal.js"
    },
    "./hello-world": {
      "types": "./lib/types/plugins/hello-world.d.ts",
      "default": "./lib/hello-world.js"
    },
    "./pnpm": {
      "types": "./lib/types/plugins/pnpm.d.ts",
      "default": "./lib/pnpm.js"
    },
    "./profile-service": {
      "types": "./lib/types/profile/profile-service.d.ts",
      "default": "./lib/profile-service.js"
    },
    "./desktop-plugins": {
      "types": "./lib/types/plugins/desktop-plugins.d.ts",
      "default": "./lib/desktop-plugins.js"
    },
    "./profiles": {
      "types": "./lib/types/profile/profiles.d.ts",
      "default": "./lib/profiles.js"
    },
    "./diagnostics": {
      "types": "./lib/types/diagnostics/diagnostics.d.ts",
      "default": "./lib/diagnostics.js"
    },
    "./notifications": {
      "types": "./lib/types/shell/notifications.d.ts",
      "default": "./lib/notifications.js"
    },
    "./updates": {
      "types": "./lib/types/updates/updates.d.ts",
      "default": "./lib/updates.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/app-icon.png",
    "build/app-icon-mac.png",
    "build/tray-icon.svg",
    "build/tray-icon*.png",
    "cordis.patch.yml",
    "docs/**",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/native-ui/**",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter acryl-control run build && pnpm --filter acryl-loopback-http run build && pnpm --filter acryl-diagnostics run build && pnpm --filter @webboxes/blends-core run build && pnpm --filter @webboxes/app-persistence run build && pnpm --filter acryl-harness-runtime run build && pnpm --filter dsh-client-ui-brand-acryl run build && pnpm --filter @acryl/ui run build && pnpm --filter acryl-settings run build && pnpm --filter acryl-shortcuts run build && pnpm --filter acryl-mount-anchors run build && pnpm --filter acryl-app-shell run build && pnpm --filter acryl-workspace run build && pnpm --filter acryl-plugin-admin run build && pnpm --filter acryl-support run build && pnpm --filter acryl-agent-control run build && pnpm --filter cordis-plugin-market run build",
    "build": "node scripts/generate-acryl-brand.mjs && node scripts/generate-mac-app-icon.mjs && node scripts/generate-tray-icons.mjs && node scripts/clean.mjs && tsdown && vite build --config vite.native-ui.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "pretypecheck": "pnpm run prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.native-ui.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.tests.client.json --noEmit",
    "pretest": "pnpm run prebuild",
    "test": "vitest run && node --test scripts/launch-dev.spec.mjs",
    "verify:closure": "node --test scripts/runtime-closure.spec.mjs && node scripts/verify-runtime-closure.mjs",
    "verify:cli": "node scripts/verify-cli-runtime.mjs",
    "verify:loader": "node scripts/verify-loader-boot.mjs",
    "dump:system-prompt": "node scripts/verify-loader-boot.mjs --dump-system-prompt ../../docs/system-prompt/current",
    "verify:profile": "node scripts/verify-profile-boot.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:notices": "node scripts/verify-licenses.mjs --notices THIRD_PARTY_NOTICES.md",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run verify:closure && pnpm run verify:cli && pnpm run verify:loader && pnpm run verify:profile && pnpm run verify:licenses",
    "check:win-package": "pnpm --filter cordis-plugin-market run build && pnpm run build && pnpm run typecheck && vitest run tests/package.spec.ts tests/package-win.spec.ts tests/updates/update-checker.spec.ts tests/updates/update-download.spec.ts tests/verify-win-installer.spec.ts tests/verify-win-portable.spec.ts tests/verify-packaged-runtime.spec.ts tests/windows/windows-agent-presets.spec.ts tests/windows/windows-pwsh-sandbox.spec.ts tests/workspaces/windows-volume-diagnostics.spec.ts tests/shell/window-options.spec.ts && pnpm run verify:closure",
    "check:mac-package": "pnpm --filter cordis-plugin-market run build && pnpm run build && pnpm run typecheck && vitest run tests/package.spec.ts tests/package-mac.spec.ts tests/verify-mac-smoke.spec.ts tests/verify-packaged-runtime.spec.ts tests/mac-universal.spec.ts && pnpm run verify:closure",
    "start": "node lib/bin.js",
    "dev": "node ../../scripts/with-build-lock.mjs pnpm run build && pnpm run verify:loader && node scripts/launch-dev.mjs",
    "package:dir": "pnpm run build && node scripts/package-dir.mjs",
    "dist:mac": "node scripts/release-mac.ts",
    "dist:mac-smoke": "node scripts/package-mac.ts",
    "dist:mac-host": "node scripts/package-mac.ts --host",
    "dist:linux": "node scripts/package-linux.ts",
    "dist:win": "node scripts/package-win.ts",
    "dist:win-portable": "node scripts/package-win-portable.ts",
    "prepack": "pnpm run check"
  },
