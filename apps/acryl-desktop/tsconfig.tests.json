{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": [
    "src/client/**",
    "src/native-ui/**",
    // Detached with the Windows pwsh sandbox (see WINDOWS_PWSH_SANDBOX_REATTACHED in src/profile.ts); its pure helpers live in windows-acl-adaptation.ts.
    "src/windows-pwsh-sandbox.ts",
    "tests/client-acryl-brand.spec.ts",
    "tests/client-boot-health.spec.ts",
    "tests/client/settings/client-desktop-settings.spec.ts",
    "tests/client/settings/desktop-preferences.spec.ts",
    "tests/client/layout/client-environment.spec.ts",
    "tests/client/layout/theme-presenter.spec.ts",
    "tests/client/workspaces/client-workspace-folder-drop.spec.ts"
  ]
}
