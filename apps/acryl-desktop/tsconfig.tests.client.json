{
  "extends": "./tsconfig.client.json",
  // The Desktop settings page is detached (see the DETACHED note in src/client/index.ts); its spec still runs under vitest.
  "exclude": [
    "src/client/settings/desktop-settings.ts",
    "src/client/settings/DesktopSettingsSection.tsx",
    "src/client/settings/DesktopTerminalSettingsAction.tsx",
    "tests/client/settings/client-desktop-settings.spec.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "emitDeclarationOnly": false
  },
  "include": [
    "src/client/layout/advanced-shell.ts",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "tests/client-acryl-brand.spec.ts",
    "tests/client-boot-health.spec.ts",
    "tests/client/workspaces/client-directory-picker.spec.ts",
    "tests/client/settings/client-desktop-settings.spec.ts",
    "tests/client/layout/client-environment.spec.ts",
    "tests/plugins/architecture/client-plugin-architecture-api.spec.ts",
    "tests/client/plugin-lifecycle/client-plugin-lifecycle-api.spec.ts",
    "tests/client/workspaces/client-workspace-folder-drop.spec.ts",
    "tests/client/layout/theme-presenter.spec.ts"
  ]
}
