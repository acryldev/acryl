+/**
+* ACRYL: what `import(name)` loads when `baseUrl` makes the import, through Node's public resolver. Node's internal loader resolved a
+* bare name from the tree's base; without the native internals add-on, which ACRYL does not install, the import would come from this
+* file instead, and a package installed into a profile while the app runs would not be found. The CommonJS resolver with the ESM
+* conditions selects the same package "exports" target, and the host's profile interception routes it the same way.
+*/
+function importTargetFrom(name, baseUrl) {
+	if (name.startsWith("file:") || isBuiltin(name)) return name;
+	const base = fileURLToPath(baseUrl);
+	const anchor = baseUrl.endsWith("/") ? join(base, "package.json") : base;
+	const parent = new Module(anchor);
+	parent.filename = anchor;
+	parent.paths = Module._nodeModulePaths(dirname(anchor));
+	const target = Module._resolveFilename(name, parent, false, { conditions: new Set(["node", "import"]) });
+	return isBuiltin(target) ? target : pathToFileURL(target).href;
+}
