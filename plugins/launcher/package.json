{
  "name": "@acryldev/launcher",
  "version": "0.2.1",
  "description": "The ACRYL launcher's journeys (create an app, install a Blend, pull or share a plugin, update, check this machine, open ACRYL ADE) and the session every face walks them with (spec 050)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/launcher"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/launcher#readme",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./node": "./node-context.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "journeys.js",
    "session.js",
    "apps-registry.js",
    "apps-command.js",
    "app-space.js",
    "os-launchers.js",
    "shortcut-open.mjs",
    "model-key.js",
    "github-login.js",
    "tools.js",
    "app-install.js",
    "app-install-cli.mjs",
    "node-context.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "dependencies": {
    "@acryldev/app-persistence": "workspace:^",
    "@acryldev/instance": "workspace:^"
  }
}
