{
  "name": "@acryldev/ui-tui",
  "version": "0.1.0",
  "description": "ACRYL UI library for the terminal (CLI): pi-tui components with the same names and contracts as @acryldev/ui (Stack, Card, Field, SwitchField, SettingsRow, SelectField, Segmented, Tabs, Dialog, EmptyState), themed by the shared semantic roles",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./palette": "./palette.js",
    "./scheme": "./scheme.js"
  },
  "files": [
    "index.js",
    "palette.js",
    "scheme.js",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "acryl": {
    "apiVersion": 1,
    "permissions": []
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/ui-tui"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/ui-tui#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  }
}
