{
  "name": "@acryldev/coding-capabilities",
  "version": "0.1.1",
  "description": "How ACRYL's coding capabilities compose on each product surface: the Loader rows, the packages a surface must make resolvable, and the shell-mode split. The Blueprint vocabulary stays in @acryldev/harness-runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/coding-capabilities"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/coding-capabilities#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@acryldev/ui": "workspace:*",
    "@acryldev/agent-control": "workspace:*",
    "@acryldev/app-save": "workspace:*",
    "@acryldev/app-shell": "workspace:*",
    "@acryldev/brand": "workspace:*",
    "@acryldev/command-reply": "workspace:*",
    "@acryldev/launcher-desktop": "workspace:*",
    "@acryldev/mount-anchors": "workspace:*",
    "@acryldev/plugin-admin": "workspace:*",
    "@acryldev/plugin-context": "workspace:*",
    "@acryldev/plugin-hub": "workspace:*",
    "@acryldev/settings": "workspace:*",
    "@acryldev/shortcuts": "workspace:*",
    "@acryldev/sign-in": "workspace:*",
    "@acryldev/support": "workspace:*",
    "@acryldev/system-prompt": "workspace:*",
    "@acryldev/ui-tui": "workspace:*",
    "@acryldev/workspace": "workspace:*",
    "@acryldev/cordis-plugin-market": "workspace:*",
    "@acryldev/brand-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "lib/**"
  ]
}
