{
  "name": "acryl-example-chat-message-action",
  "version": "0.1.0",
  "private": true,
  "description": "Adds a Bookmark action under every finished assistant message (conversation.chat.assistant-actions slot)",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  }
}
