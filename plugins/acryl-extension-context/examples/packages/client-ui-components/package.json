{
  "name": "acryl-example-ui-components",
  "version": "0.1.0",
  "private": true,
  "description": "Quick-notes launcher built from the shared UI primitives (Button, Modal, Input, Switch, Tag) in the sidebar footer",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
