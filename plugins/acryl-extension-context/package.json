{
  "name": "acryl-extension-context",
  "version": "0.1.0",
  "description": "Extension Context Pack: routed docs, verified examples and authoring skills that let the ACRYL agent write its own plugins (spec 037)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/acryl-extension-context"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/acryl-extension-context#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./manifest": "./docs/docs.json"
  },
  "files": [
    "index.js",
    "lib/**",
    "docs/**",
    "example-plugins/**",
    "skills/**",
    "scripts/lib/**"
  ],
  "scripts": {
    "sync:corpus": "node scripts/sync-corpus.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "verify:manifest": "node scripts/build-manifest.mjs --check",
    "test": "node --test scripts/manifest.test.mjs scripts/plugin.test.mjs",
    "check": "pnpm run test && pnpm run verify:manifest"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./index.js",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-tui": "0.84.2"
  }
}
