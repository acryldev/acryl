{
  "name": "acryl-plugin-hub",
  "version": "0.1.0",
  "description": "Save, share and pull plugins in an app: the pluginHub service (the local store, pulls checked by sha512 and by the services the app provides, installed through DSH's own plugin manager) and the /plugin chat command",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/acryl-plugin-hub"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manager": "./manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "manager.js",
    "release-spec.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@webboxes/plugin-hub": "workspace:*"
  }
}
