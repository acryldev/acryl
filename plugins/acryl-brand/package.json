{
  "name": "acryl-brand",
  "version": "0.1.0",
  "description": "Configurable brand for the Web and Desktop client: product name, mark, accent color, font and page title, set from the plugin row's config so anyone can ship ACRYL under their own name",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/acryl-brand"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/acryl-brand#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
