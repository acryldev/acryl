{
  "name": "acryl-builder",
  "version": "0.1.0",
  "description": "The agent's tools for building the app it runs in: write, install, read, list and remove extensions, with real results.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/builder"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/builder#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./script": {
      "types": "./lib/types/script.d.ts",
      "default": "./lib/script.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "acryl-agent": "workspace:*",
    "acryl-extensions": "workspace:*",
    "acryl-instance": "workspace:*",
    "acryl-plugin-share": "workspace:*",
    "@webboxes/blends-core": "0.5.0",
    "@webboxes/plugin-hub": "0.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly"
  }
}
