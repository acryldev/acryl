{
  "name": "@acryldev/page",
  "version": "0.1.2",
  "license": "MIT",
  "description": "The page of a framework-hosted app: the ACRYL frame's own minimal document, its index taps applied per request, and the built client assets the client runtime boots from, served by @acryldev/web-server",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check"
  },
  "dependencies": {
    "@acryldev/web-server": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@acryldev/node-server": "workspace:*",
    "@acryldev/router": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-web-frontend": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl.git",
    "directory": "plugins/page"
  },
  "homepage": "https://github.com/acryldev/acryl/tree/main/plugins/page#readme",
  "bugs": {
    "url": "https://github.com/acryldev/acryl/issues"
  }
}
