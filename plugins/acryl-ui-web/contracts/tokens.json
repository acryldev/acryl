{
  "schemaVersion": 1,
  "note": "Semantic roles (spec 038-ui-component-library, Q3 in research.md, approved). Components and the terminal layer name only these roles. This file is the ONLY place that maps a role to the app's --dsw-alias-* tokens, so an upstream rename touches one line. Roles marked new have no app token and are defined by this library with light-dark().",
  "roles": {
    "text":           { "web": "var(--dsw-alias-label-primary)",   "terminal": { "dark": null,      "light": null } },
    "textMuted":      { "web": "var(--dsw-alias-label-tertiary)",  "terminal": { "dark": "#94A3B8", "light": "#64748B" } },
    "textDimmed":     { "web": "var(--dsw-alias-label-dimmed)",    "terminal": { "dark": "#64748B", "light": "#94A3B8" } },
    "surface":        { "web": "var(--dsw-alias-bg-layer-1)",      "terminal": { "dark": null,      "light": null } },
    "surfaceRaised":  { "web": "var(--dsw-alias-bg-layer-2)",      "terminal": { "dark": null,      "light": null } },
    "border":         { "web": "var(--dsw-alias-border-l4)",       "terminal": { "dark": "#475569", "light": "#CBD5E1" } },
    "primary":        { "web": "var(--dsw-alias-brand-primary)",   "terminal": { "dark": "#4F6BFE", "light": "#3652D9" } },
    "success":        { "web": "var(--dsw-alias-state-success-primary)", "terminal": { "dark": "#34D399", "light": "#059669" } },
    "warning":        { "web": "var(--dsw-alias-state-warn-primary)",    "terminal": { "dark": "#FBBF24", "light": "#B45309" } },
    "error":          { "web": "var(--dsw-alias-state-error-primary)",   "terminal": { "dark": "#F87171", "light": "#DC2626" } },
    "info":           { "web": "var(--dsw-alias-button-info-fill)",      "terminal": { "dark": "#4F6BFE", "light": "#3652D9" } },
    "accent":         { "web": "light-dark(#4F46E5, #818CF8)", "new": true, "terminal": { "dark": "#818CF8", "light": "#4F46E5" } },
    "reasoning":      { "web": "light-dark(#7C3AED, #A855F7)", "new": true, "terminal": { "dark": "#A855F7", "light": "#7E22CE" } }
  }
}
